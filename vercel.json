{
  "framework": "vite",
  "installCommand": "npm --prefix insurance-agent-frontend ci --include=dev",
  "buildCommand": "npm --prefix insurance-agent-frontend run build",
  "outputDirectory": "insurance-agent-frontend/dist",
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
